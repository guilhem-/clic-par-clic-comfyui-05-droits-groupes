# Open WebUI: address and token of an administrator account (Settings > Account > API keys, or a session token).
OWUI_URL=http://127.0.0.1:8080
OWUI_TOKEN=
# The group that may generate images, and its members (emails, comma separated).
GROUP_NAME=Communication
GROUP_MEMBERS=
# Model and tool reserved for the group (ids in Open WebUI).
MODEL_ID=image-workshop
TOOL_ID=image_workshop
# Reserve the tool as well (recommended). The video sets false on purpose, to test the check inside the tool.
RESTRICT_TOOL=true
# Only for --install-workshop: chat model the "Image workshop" model is based on (must be able to call tools).
BASE_MODEL=

# Only for test/check-permissions.sh: tokens of a group member and of a user outside the group.
MEMBER_TOKEN=
OUTSIDER_TOKEN=
